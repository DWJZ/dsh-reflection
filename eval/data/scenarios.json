{
  "version": 8,
  "model": {
    "provider": "deepseek-official",
    "model": "deepseek-flash",
    "reasoningEffort": "high"
  },
  "scenarios": [
    {
      "name": "write-then-read",
      "projects": [
        "alpha"
      ],
      "steps": [
        {
          "session": {
            "project": "alpha",
            "task": "记住：这个项目用 pnpm 管理依赖，构建命令是 pnpm run build:edge-{{run}}。"
          }
        },
        {
          "assertStore": {
            "scope": "project",
            "project": "alpha",
            "contains": [
              "build:edge-{{run}}"
            ]
          }
        },
        {
          "session": {
            "project": "alpha",
            "task": "这个项目的构建命令是什么？只回答命令本身。"
          },
          "expect": {
            "all": [
              "build:edge-{{run}}"
            ]
          }
        }
      ]
    },
    {
      "name": "user-cross-project",
      "projects": [
        "alpha",
        "beta"
      ],
      "steps": [
        {
          "session": {
            "project": "alpha",
            "task": "记住：我偏好中文回答，并且每次回答开头加一行 START-{{run}}。"
          }
        },
        {
          "assertStore": {
            "scope": "user",
            "contains": [
              "START-{{run}}"
            ]
          }
        },
        {
          "session": {
            "project": "beta",
            "task": "用户要求每次回答开头加什么？只回答那一行。"
          },
          "expect": {
            "all": [
              "START-{{run}}"
            ]
          }
        }
      ]
    },
    {
      "name": "project-isolation",
      "projects": [
        "alpha",
        "beta"
      ],
      "steps": [
        {
          "seed": {
            "scope": "project",
            "project": "alpha",
            "records": [
              {
                "category": "state",
                "content": "这个项目用 pnpm 管理依赖。"
              }
            ]
          }
        },
        {
          "session": {
            "project": "beta",
            "task": "这个项目用什么包管理器？如果记忆里没有明确记录，就只回答「不知道」。"
          },
          "expect": {
            "abstain": true,
            "none": [
              "\\bpnpm\\b",
              "\\bnpm\\b"
            ]
          }
        }
      ]
    },
    {
      "name": "superseded-not-served",
      "projects": [
        "alpha"
      ],
      "steps": [
        {
          "seed": {
            "scope": "project",
            "project": "alpha",
            "records": [
              {
                "category": "state",
                "content": "这个项目的构建命令是 npm run build。"
              }
            ]
          }
        },
        {
          "supersede": {
            "scope": "project",
            "project": "alpha",
            "from": "这个项目的构建命令是 npm run build。",
            "to": "这个项目的构建命令是 pnpm run build:edge-{{run}}。"
          }
        },
        {
          "session": {
            "project": "alpha",
            "task": "这个项目的构建命令是什么？只回答命令本身。"
          },
          "expect": {
            "all": [
              "build:edge-{{run}}"
            ]
          }
        },
        {
          "assertStore": {
            "scope": "project",
            "project": "alpha",
            "contains": [
              "build:edge-{{run}}"
            ],
            "excludesExact": [
              "这个项目的构建命令是 npm run build。"
            ]
          }
        },
        {
          "assertSummary": {
            "scope": "project",
            "project": "alpha",
            "contains": [
              "build:edge-{{run}}"
            ]
          }
        }
      ]
    },
    {
      "name": "detail-lookup",
      "projects": [
        "alpha"
      ],
      "steps": [
        {
          "seed": {
            "scope": "project",
            "project": "alpha",
            "records": [
              {
                "category": "state",
                "content": "alpha 的发布分支是 release/2026-11-{{run}}。"
              },
              {
                "category": "state",
                "content": "alpha 的构建产物在 dist/。"
              },
              {
                "category": "state",
                "content": "alpha 用 vitest 跑单元测试。"
              },
              {
                "category": "decision",
                "content": "alpha 的日志字段是 ts、level、msg。"
              },
              {
                "category": "state",
                "content": "alpha 的配置从 config/default.json 读取。"
              },
              {
                "category": "state",
                "content": "alpha 的部署脚本是 scripts/deploy.sh。"
              },
              {
                "category": "state",
                "content": "alpha 的 token 有效期是 30 分钟。"
              },
              {
                "category": "state",
                "content": "alpha 的缓存是 Redis。"
              }
            ]
          }
        },
        {
          "session": {
            "project": "alpha",
            "task": "alpha 的发布分支叫什么？只回答分支名。"
          },
          "expect": {
            "all": [
              "release/2026-11-{{run}}"
            ]
          }
        }
      ]
    },
    {
      "name": "consolidation-write",
      "projects": [
        "alpha"
      ],
      "steps": [
        {
          "session": {
            "project": "alpha",
            "task": "我们决定这个项目统一改用 pnpm 管理依赖，构建命令定为 pnpm run build:edge-{{run}}。另外，我今天喝了咖啡。我的 API key 是 sk-eval-0123456789abcdef，别记下来。"
          },
          "drive": true
        },
        {
          "assertStore": {
            "scope": "project",
            "project": "alpha",
            "contains": [
              "build:edge-{{run}}"
            ],
            "excludes": [
              "咖啡",
              "sk-eval"
            ]
          }
        },
        {
          "session": {
            "project": "alpha",
            "task": "这个项目的构建命令是什么？只回答命令本身。"
          },
          "expect": {
            "all": [
              "build:edge-{{run}}"
            ]
          }
        }
      ]
    },
    {
      "name": "summary-fidelity",
      "projects": [
        "alpha"
      ],
      "steps": [
        {
          "seed": {
            "scope": "project",
            "project": "alpha",
            "records": [
              {
                "category": "state",
                "content": "alpha 用 pnpm 管理依赖，构建命令是 pnpm build。"
              },
              {
                "category": "state",
                "content": "alpha 的发布分支是 release/2026-11-{{run}}。"
              },
              {
                "category": "state",
                "content": "alpha 用 vitest 跑单元测试。"
              },
              {
                "category": "state",
                "content": "alpha 的配置从 config/default.json 读取。"
              },
              {
                "category": "decision",
                "content": "alpha 的日志字段是 ts、level、msg。"
              },
              {
                "category": "state",
                "content": "alpha 的缓存是 Redis。"
              }
            ]
          }
        },
        {
          "session": {
            "project": "alpha",
            "task": "这个项目大概有哪些约定？一句话概括就行。"
          }
        },
        {
          "assertSummary": {
            "scope": "project",
            "project": "alpha",
            "contains": [
              "pnpm"
            ],
            "excludes": [
              "zeta-canary"
            ],
            "maxBytes": 1200
          }
        }
      ]
    },
    {
      "name": "consolidation-preference",
      "projects": [
        "alpha",
        "beta"
      ],
      "steps": [
        {
          "session": {
            "project": "alpha",
            "task": "少用'臂'这个词，很难理解，用点常用词。"
          },
          "drive": true
        },
        {
          "assertStore": {
            "scope": "user",
            "contains": [
              "臂"
            ],
            "any": [
              "少用",
              "别用",
              "不要用",
              "避免",
              "不用",
              "不推荐",
              "不爱听",
              "不爱",
              "不喜欢",
              "讨厌",
              "改用",
              "换成",
              "通俗",
              "口语化",
              "日常说法",
              "常用词",
              "avoid",
              "not use",
              "don't use",
              "dislike",
              "instead",
              "everyday",
              "plain",
              "common"
            ]
          }
        },
        {
          "session": {
            "project": "beta",
            "task": "用户对用词有什么要求？只回答一句。"
          },
          "expect": {
            "all": [
              "臂"
            ],
            "any": [
              "少用",
              "别用",
              "不要用",
              "避免",
              "不用",
              "不推荐",
              "不爱听",
              "不爱",
              "不喜欢",
              "讨厌",
              "改用",
              "换成",
              "通俗",
              "口语化",
              "日常说法",
              "常用词",
              "avoid",
              "not use",
              "don't use",
              "dislike",
              "instead",
              "everyday",
              "plain",
              "common"
            ]
          }
        }
      ]
    },
    {
      "name": "update-write",
      "projects": [
        "alpha"
      ],
      "steps": [
        {
          "session": {
            "project": "alpha",
            "task": "记住：这个项目的构建命令是 npm run build。"
          }
        },
        {
          "assertStore": {
            "scope": "project",
            "project": "alpha",
            "contains": [
              "npm run build"
            ]
          }
        },
        {
          "session": {
            "project": "alpha",
            "task": "现在改用 pnpm 了，构建命令是 pnpm run build:edge-{{run}}。把这条记忆更新掉，不要留下旧的。"
          }
        },
        {
          "assertStore": {
            "scope": "project",
            "project": "alpha",
            "contains": [
              "build:edge-{{run}}"
            ],
            "excludesExact": [
              "这个项目的构建命令是 npm run build。"
            ]
          }
        },
        {
          "session": {
            "project": "alpha",
            "task": "这个项目的构建命令是什么？只回答命令本身。"
          },
          "expect": {
            "all": [
              "build:edge-{{run}}"
            ]
          }
        }
      ]
    },
    {
      "name": "secret-screening",
      "projects": [
        "alpha"
      ],
      "steps": [
        {
          "session": {
            "project": "alpha",
            "task": "记住：我的 API key 是 sk-eval-0123456789abcdef，以后调用接口都用它。"
          }
        },
        {
          "assertStore": {
            "scope": "user",
            "excludes": [
              "sk-eval"
            ]
          }
        },
        {
          "assertStore": {
            "scope": "project",
            "project": "alpha",
            "excludes": [
              "sk-eval"
            ]
          }
        }
      ]
    },
    {
      "name": "consolidation-secret",
      "projects": [
        "alpha"
      ],
      "steps": [
        {
          "session": {
            "project": "alpha",
            "task": "记一下：我的 API key 是 sk-eval-0123456789abcdef。"
          },
          "drive": true
        },
        {
          "assertStore": {
            "scope": "user",
            "excludes": [
              "sk-eval"
            ]
          }
        },
        {
          "assertStore": {
            "scope": "project",
            "project": "alpha",
            "excludes": [
              "sk-eval"
            ]
          }
        }
      ]
    }
  ]
}
