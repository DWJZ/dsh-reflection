  "records": [
    { "id": "mem_eval_u01", "scope": "user", "project": null, "category": "preference", "content": "用户偏好中文解释，技术术语保留英文，不要翻译 API 名称。", "updated_at": "2026-08-01T00:00:00.000Z" },
    { "id": "mem_eval_u02", "scope": "user", "project": null, "category": "feedback", "content": "用户不喜欢 .bak 备份文件：改文件前不要生成 *.bak，需要退路时用 git。", "updated_at": "2026-08-02T00:00:00.000Z" },
    { "id": "mem_eval_u03", "scope": "user", "project": null, "category": "decision", "content": "提交信息统一用 Conventional Commits 格式：type(scope): subject。", "updated_at": "2026-08-03T00:00:00.000Z" },
    { "id": "mem_eval_u04", "scope": "user", "project": null, "category": "preference", "content": "用户希望先给结论再给理由，回答尽量短。", "updated_at": "2026-08-04T00:00:00.000Z" },
    { "id": "mem_eval_u05", "scope": "user", "project": null, "category": "reference", "content": "用户的时区是 America/Los_Angeles，排期按本地时间。", "updated_at": "2026-08-05T00:00:00.000Z" },
    { "id": "mem_eval_u06", "scope": "user", "project": null, "category": "lesson", "content": "在这个环境里，任何依赖 /opt/homebrew 下二进制的命令都可能被沙箱拒绝，需要申请 danger-full-access。", "updated_at": "2026-08-06T00:00:00.000Z" },

    { "id": "mem_eval_o01", "scope": "project", "project": "orion", "category": "state", "content": "orion 用 pnpm 管理依赖，构建命令是 pnpm build，产物在 dist/。", "updated_at": "2026-08-10T00:00:00.000Z" },
    { "id": "mem_eval_o02", "scope": "project", "project": "orion", "category": "state", "content": "orion 的本地开发端口是 4310，预览端口是 4311。", "updated_at": "2026-08-10T00:00:00.000Z" },
    { "id": "mem_eval_o03", "scope": "project", "project": "orion", "category": "decision", "content": "orion 的 CI 在 GitHub Actions 上跑 pnpm test 与 pnpm lint，两个都绿才能合并。", "updated_at": "2026-08-11T00:00:00.000Z" },
    { "id": "mem_eval_o04", "scope": "project", "project": "orion", "category": "state", "content": "orion 的部署脚本是 scripts/deploy.sh，发布前必须打 git tag。", "updated_at": "2026-08-11T00:00:00.000Z" },
    { "id": "mem_eval_o05", "scope": "project", "project": "orion", "category": "lesson", "content": "orion 的配置从 config/default.json 读取，环境变量会覆盖同名键。", "updated_at": "2026-08-12T00:00:00.000Z" },
    { "id": "mem_eval_o06", "scope": "project", "project": "orion", "category": "state", "content": "orion 的数据库迁移用 dbmate，迁移文件放在 migrations/ 目录。", "updated_at": "2026-08-12T00:00:00.000Z" },
    { "id": "mem_eval_o07", "scope": "project", "project": "orion", "category": "decision", "content": "orion 的日志统一用 JSON 行格式，字段是 ts、level、msg、trace_id。", "updated_at": "2026-08-13T00:00:00.000Z" },
    { "id": "mem_eval_o08", "scope": "project", "project": "orion", "category": "state", "content": "orion 的鉴权走 Bearer token，token 由 /auth/token 签发，有效期 30 分钟。", "updated_at": "2026-08-13T00:00:00.000Z" },
    { "id": "mem_eval_o09", "scope": "project", "project": "orion", "category": "feedback", "content": "orion 里不要直接改 generated/ 下的文件，改源文件再重新生成。", "updated_at": "2026-08-14T00:00:00.000Z" },
    { "id": "mem_eval_o10", "scope": "project", "project": "orion", "category": "state", "content": "orion 的测试框架是 vitest，e2e 用 playwright 放在 e2e/ 目录。", "updated_at": "2026-08-14T00:00:00.000Z" },
    { "id": "mem_eval_o11", "scope": "project", "project": "orion", "category": "decision", "content": "orion 的 API 版本写在路径里（/v1/...），不放在 header。", "updated_at": "2026-08-15T00:00:00.000Z" },
    { "id": "mem_eval_o12", "scope": "project", "project": "orion", "category": "lesson", "content": "orion 的构建偶发 OOM，需要把 NODE_OPTIONS 设成 --max-old-space-size=4096。", "updated_at": "2026-08-15T00:00:00.000Z" },

    { "id": "mem_eval_a01", "scope": "project", "project": "atlas", "category": "state", "content": "atlas 用 uv 管理依赖，运行入口是 uv run python -m atlas。", "updated_at": "2026-08-10T00:00:00.000Z" },
    { "id": "mem_eval_a02", "scope": "project", "project": "atlas", "category": "state", "content": "atlas 的测试框架是 pytest，命令是 uv run pytest -q。", "updated_at": "2026-08-10T00:00:00.000Z" },
    { "id": "mem_eval_a03", "scope": "project", "project": "atlas", "category": "state", "content": "atlas 监听 8008 端口，健康检查路径是 /healthz。", "updated_at": "2026-08-11T00:00:00.000Z" },
    { "id": "mem_eval_a04", "scope": "project", "project": "atlas", "category": "decision", "content": "atlas 的数据库迁移用 alembic，迁移脚本在 alembic/versions/。", "updated_at": "2026-08-11T00:00:00.000Z" },
    { "id": "mem_eval_a05", "scope": "project", "project": "atlas", "category": "state", "content": "atlas 的缓存是 Redis，连接串从 REDIS_URL 读取。", "updated_at": "2026-08-12T00:00:00.000Z" },
    { "id": "mem_eval_a06", "scope": "project", "project": "atlas", "category": "decision", "content": "atlas 的镜像基于 python:3.12-slim，用多阶段构建。", "updated_at": "2026-08-12T00:00:00.000Z" },
    { "id": "mem_eval_a07", "scope": "project", "project": "atlas", "category": "state", "content": "atlas 的错误码是四位整数，前两位表示模块。", "updated_at": "2026-08-13T00:00:00.000Z" },
    { "id": "mem_eval_a08", "scope": "project", "project": "atlas", "category": "feedback", "content": "atlas 的接口变更必须同步更新 openapi.yaml。", "updated_at": "2026-08-13T00:00:00.000Z" },
    { "id": "mem_eval_a09", "scope": "project", "project": "atlas", "category": "state", "content": "atlas 的定时任务用 APScheduler，任务定义在 atlas/jobs.py。", "updated_at": "2026-08-14T00:00:00.000Z" },
    { "id": "mem_eval_a10", "scope": "project", "project": "atlas", "category": "lesson", "content": "atlas 在 macOS 上安装 psycopg 需要先装 libpq。", "updated_at": "2026-08-14T00:00:00.000Z" },
    { "id": "mem_eval_a11", "scope": "project", "project": "atlas", "category": "state", "content": "atlas 的日志级别由 LOG_LEVEL 控制，默认 INFO。", "updated_at": "2026-08-15T00:00:00.000Z" },
    { "id": "mem_eval_a12", "scope": "project", "project": "atlas", "category": "decision", "content": "atlas 的 API 版本放在 header（X-API-Version），路径里不带版本。", "updated_at": "2026-08-15T00:00:00.000Z" },

    { "id": "mem_eval_n01", "scope": "project", "project": "nova", "category": "state", "content": "nova 用 cargo 构建，命令是 cargo build --release。", "updated_at": "2026-08-10T00:00:00.000Z" },
    { "id": "mem_eval_n02", "scope": "project", "project": "nova", "category": "state", "content": "nova 的格式化用 cargo fmt，lint 用 cargo clippy -- -D warnings。", "updated_at": "2026-08-10T00:00:00.000Z" },
    { "id": "mem_eval_n03", "scope": "project", "project": "nova", "category": "state", "content": "nova 的 wasm 产物用 wasm-pack build --target web 生成。", "updated_at": "2026-08-11T00:00:00.000Z" },
    { "id": "mem_eval_n04", "scope": "project", "project": "nova", "category": "decision", "content": "nova 的 feature 开关走 Cargo feature，默认不启用 experimental。", "updated_at": "2026-08-11T00:00:00.000Z" },
    { "id": "mem_eval_n05", "scope": "project", "project": "nova", "category": "state", "content": "nova 的基准测试用 criterion，结果在 target/criterion/。", "updated_at": "2026-08-12T00:00:00.000Z" },
    { "id": "mem_eval_n06", "scope": "project", "project": "nova", "category": "state", "content": "nova 的遥测用 OpenTelemetry，导出到 OTLP endpoint。", "updated_at": "2026-08-12T00:00:00.000Z" },
    { "id": "mem_eval_n07", "scope": "project", "project": "nova", "category": "decision", "content": "nova 的发布流程是打 tag 后由 GitHub Actions 构建三平台二进制。", "updated_at": "2026-08-13T00:00:00.000Z" },
    { "id": "mem_eval_n08", "scope": "project", "project": "nova", "category": "state", "content": "nova 的配置用 figment 读取 nova.toml，环境变量前缀是 NOVA_。", "updated_at": "2026-08-13T00:00:00.000Z" },
    { "id": "mem_eval_n09", "scope": "project", "project": "nova", "category": "lesson", "content": "nova 在 CI 上编译慢，需要开 sccache 缓存。", "updated_at": "2026-08-14T00:00:00.000Z" },
    { "id": "mem_eval_n10", "scope": "project", "project": "nova", "category": "state", "content": "nova 的错误类型用 thiserror，统一在 src/error.rs。", "updated_at": "2026-08-14T00:00:00.000Z" },
    { "id": "mem_eval_n11", "scope": "project", "project": "nova", "category": "decision", "content": "nova 的公共 API 变更必须写进 CHANGELOG.md。", "updated_at": "2026-08-15T00:00:00.000Z" },
    { "id": "mem_eval_n12", "scope": "project", "project": "nova", "category": "state", "content": "nova 的内存分配器用 mimalloc，在 main.rs 里设置。", "updated_at": "2026-08-15T00:00:00.000Z" }
