{
  "name": "dsh-reflection",
  "version": "0.1.0",
  "description": "DeepSeek Harness 持久记忆插件：把用户与项目的长期记忆存在 $DSH_HOME/memory，并在每个新会话注入紧凑索引。 / Persistent user and project memory for DeepSeek Harness, stored under $DSH_HOME/memory and injected as a compact index.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DWJZ/dsh-reflection.git"
  },
  "homepage": "https://github.com/DWJZ/dsh-reflection#readme",
  "main": "lib/index.mjs",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "npm run test:unit && node --import tsx/esm test/client.smoke.mjs",
    "test:unit": "node test/run-unit-specs.mjs",
    "test:integration": "node --import tsx/esm test/integration.spec.mjs",
    "test:all": "npm run test && npm run test:integration",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "build": "tsdown",
    "prepare": "npm run build",
    "declarations": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck:host": "tsc -p tsconfig.json",
    "typecheck:client": "tsc -p tsconfig.client.json"
  },
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "client",
    "test",
    "cordis.patch.yml",
    "CONTRACT.md",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "harness",
    "dsh-plugin",
    "memory"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-home-paths": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/dsh-home-paths": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.1",
    "@types/node": "^26.6.3",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
