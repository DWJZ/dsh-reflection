node_modules/

# Build output: `npm run prepare` produces it on install, and the profile loads
# it from this directory through a `link:` dependency.
lib/
.DS_Store
*.log

# Local working documents: build plans, review records, and the superseded
# contract draft. CONTRACT.md is the published authority; these stay on the
# maintainer's machine, because a review of code that has since changed reads as
# a current problem list once it is published.

# Evaluation artifacts: regenerated on every run, never committed.
eval/report-*.json
